{
  "expo": {
    "name": "Bloom Planner",
    "slug": "bloom-planner",
    "version": "1.4.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bloomplanner",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF7EC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.howzit5217.bloomplanner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Bloom Planner looks up your location once, to read the weather history where you plant. Only the coordinates are sent, to Open-Meteo."
      }
    },
    "android": {
      "package": "io.github.howzit5217.bloomplanner",
      "adaptiveIcon": {
        "backgroundColor": "#58D75E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Bloom Planner",
      "shortName": "Bloom Planner",
      "themeColor": "#FBF7EC",
      "backgroundColor": "#FBF7EC",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bloom Planner opens the screenshot you pick, to read your level and what's left. It stays on your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7EC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#241F18"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bloom Planner looks up your location once, to read the weather history where you plant. Only the coordinates are sent, to Open-Meteo.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3C7A3E"
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/bloom-planner/app"
    },
    "extra": {
      "githubRepo": "Howzit5217/bloom-planner",
      "beta": 0
    }
  }
}
